# Python
__pycache__/
*.py[cod]

# Output your programs write while you work.
# M14 creates this one; delete it and re-run any time.
findings.txt

# Virtual environments, if you make one
.venv/
venv/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
~$*
.idea/

# Personal editor state is ignored, but the one shared workspace setting
# is tracked: it makes the editor's Run button work from each assignment's
# own folder, which M14 depends on.
.vscode/*
!.vscode/settings.json
